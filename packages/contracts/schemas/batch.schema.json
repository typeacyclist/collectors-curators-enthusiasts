{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://collectors-curators-enthusiasts.dev/schemas/batch.schema.json",
  "title": "CCE Batch Intake and Processing Contracts",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "batchOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ClientOperationID",
        "ThingUUID",
        "CommandType",
        "Payload"
      ],
      "properties": {
        "ClientOperationID": { "$ref": "#/$defs/uuid" },
        "ThingUUID": { "$ref": "#/$defs/uuid" },
        "ExpectedVersion": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "CommandType": {
          "type": "string",
          "enum": [
            "CREATE_THING",
            "UPDATE_METADATA",
            "RECORD_EVENT",
            "CONFIRM_AI_PROPOSAL",
            "QUEUE_LABEL_PRINT"
          ]
        },
        "Payload": {
          "type": "object"
        }
      }
    },
    "batchCommandRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "BatchUUID",
        "TenantUUID",
        "ActorUserUUID",
        "Operations",
        "CreatedAt"
      ],
      "properties": {
        "BatchUUID": { "$ref": "#/$defs/uuid" },
        "TenantUUID": { "$ref": "#/$defs/uuid" },
        "ActorUserUUID": { "$ref": "#/$defs/uuid" },
        "CreatedAt": { "$ref": "#/$defs/timestamp" },
        "Operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": { "$ref": "#/$defs/batchOperation" }
        }
      }
    },
    "batchOperationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ClientOperationID",
        "ThingUUID",
        "Status"
      ],
      "properties": {
        "ClientOperationID": { "$ref": "#/$defs/uuid" },
        "ThingUUID": { "$ref": "#/$defs/uuid" },
        "Status": {
          "type": "string",
          "enum": [
            "SUCCEEDED",
            "DUPLICATE_REPLAY",
            "VALIDATION_FAILED",
            "VERSION_CONFLICT",
            "AUTHORIZATION_FAILED",
            "RETRYABLE_ERROR",
            "PERMANENT_ERROR"
          ]
        },
        "CanonicalVersion": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "ErrorCode": {
          "type": ["string", "null"]
        },
        "ErrorMessage": {
          "type": ["string", "null"],
          "maxLength": 2000
        }
      }
    },
    "batchCommandResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "BatchUUID",
        "ProcessedAt",
        "Results"
      ],
      "properties": {
        "BatchUUID": { "$ref": "#/$defs/uuid" },
        "ProcessedAt": { "$ref": "#/$defs/timestamp" },
        "Results": {
          "type": "array",
          "items": { "$ref": "#/$defs/batchOperationResult" }
        }
      }
    },
    "mediaProcessingMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "SourceWidth",
        "SourceHeight",
        "ProcessedAtEdge",
        "ProcessingProfileVersion"
      ],
      "properties": {
        "SourceWidth": { "type": "integer", "minimum": 1 },
        "SourceHeight": { "type": "integer", "minimum": 1 },
        "DerivativeWidth": { "type": ["integer", "null"], "minimum": 1 },
        "DerivativeHeight": { "type": ["integer", "null"], "minimum": 1 },
        "Encoding": { "type": ["string", "null"] },
        "Quality": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "RoiCropped": { "type": "boolean", "default": false },
        "CropX": { "type": ["integer", "null"], "minimum": 0 },
        "CropY": { "type": ["integer", "null"], "minimum": 0 },
        "CropWidth": { "type": ["integer", "null"], "minimum": 1 },
        "CropHeight": { "type": ["integer", "null"], "minimum": 1 },
        "ProcessedAtEdge": { "type": "boolean" },
        "OriginalRetained": { "type": "boolean", "default": true },
        "ProcessingProfileVersion": { "type": "string", "minLength": 1 }
      }
    },
    "printJob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "PrintJobUUID",
        "TenantUUID",
        "ThingUUID",
        "LabelID",
        "LabelTemplateID",
        "LabelTemplateVersion",
        "Quantity",
        "State",
        "CreatedAt"
      ],
      "properties": {
        "PrintJobUUID": { "$ref": "#/$defs/uuid" },
        "TenantUUID": { "$ref": "#/$defs/uuid" },
        "ThingUUID": { "$ref": "#/$defs/uuid" },
        "LabelID": { "$ref": "#/$defs/uuid" },
        "LabelTemplateID": { "type": "string", "minLength": 1 },
        "LabelTemplateVersion": { "type": "string", "minLength": 1 },
        "Quantity": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "State": {
          "type": "string",
          "enum": [
            "QUEUED",
            "SPOOLING",
            "READY",
            "PRINT_REQUESTED",
            "PRINT_CONFIRMED",
            "FAILED",
            "CANCELED"
          ]
        },
        "CreatedAt": { "$ref": "#/$defs/timestamp" },
        "LastPrintedAt": {
          "anyOf": [
            { "$ref": "#/$defs/timestamp" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
